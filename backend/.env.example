# ---- Coda 后端配置 ----------------------------------------------
# 所有变量都是可选的；不填时使用下面注释里的默认值，本地开发开箱即用。

# SQLite 数据库、工作目录与自动生成的密钥文件存放位置。
# CODA_DATA_DIR=./data

# 显式指定数据库地址（会覆盖由 CODA_DATA_DIR 推导出的路径）
# CODA_DATABASE_URL=sqlite+aiosqlite:///./data/coda.db

# 用于加密已存 API 密钥的密钥（任意字符串 -> sha256 -> Fernet key）。
# 不设置时会自动生成 <data_dir>/secret.key，权限 0600。
# CODA_SECRET_KEY=change-me-in-production

# 智能体工作目录的根路径（默认 <data_dir>/workspaces）
# CODA_WORKSPACE_DIR=./data/workspaces

# 允许的跨域来源，逗号分隔，或用 * 表示任意来源
# CODA_CORS_ORIGINS=http://localhost:5173

# 普通对话单轮运行的时限（秒）。默认不限时（不配置或留空即为不限时）；
# 只想给对话加护栏时再显式设置，例如 7200。协作域不受它影响：协作的每一步走自己的单步限时。
# CODA_RUN_TIMEOUT_SECONDS=7200

# ---- 多用户与鉴权 ----------------------------------------------------------
# 是否开启鉴权（默认 true，多用户形态）。想要单用户开箱即用可显式设为 false。
# 空库首启请配置 CODA_ADMIN_USERNAME / CODA_ADMIN_PASSWORD，或保持注册开放、
# 让第一个注册的账号自动成为管理员。
# CODA_AUTH_ENABLED=true
# 是否开放自助注册（默认 true）；关闭后只能由管理员在「设置 → 用户」建账号。
# CODA_REGISTRATION_OPEN=true
# 空库首启时创建首任管理员（已有用户时不生效）。老库的存量数据会回填给这个管理员。
# CODA_ADMIN_USERNAME=admin
# CODA_ADMIN_PASSWORD=change-me-please

# 监听地址与端口（由 scripts/serve.sh 读取）
# CODA_HOST=0.0.0.0
# CODA_PORT=8010

# 平台对外地址（系统管理 MCP 自动填写用的平台地址）。
# 留空时按 http://127.0.0.1:<CODA_PORT> 处理；部署在反向代理 / 容器网络后面时
# 填 MCP 子进程实际能访问到的地址，例如 https://coda.example.com
# CODA_PUBLIC_BASE_URL=https://coda.example.com

# 任务进度卡 MCP 通道（灰度，默认 0）：1 时，声明了 Capabilities.mcp 的内核
# （Claude Code / Codex / CodeBuddy / Hermes / DeepSeek Harness）在多步任务回合通过
# 内置工具 update_task_card 更新输入框上方的卡片；0 时完全回到正文 task_card 围栏。
# 「MCP」页始终展示一条「任务进度卡」平台内置项（assignable=False，只展示不分配）。
# 注意：运行绑定在进程内存，当前按单进程部署；多 worker 需要迁共享存储或粘性会话。
# CODA_TASK_CARD_MCP=0

# 需要取回对话工作区的图片 URL 前缀（逗号分隔）。只在「网关代跑」形态下需要：
# 图片 MCP 配了 IMAGE_PUBLIC_BASE_URL 时，图片只由图床托管；平台在助手消息落库前
# 按这里的前缀把图下载到对话工作目录并改写成相对路径（不配置则完全不抓外链）。
# CODA_IMAGE_INGEST_PREFIXES=https://img.example.com

# ---- 适配器凭据 ------------------------------------------------------------
# 这些变量遵循各 CLI 工具自身的约定，只有在界面上留空 API 密钥字段时才会被读取
# （即「环境既存凭据 / ambient credentials」）。
# ANTHROPIC_BASE_URL=...      ANTHROPIC_AUTH_TOKEN=...
# OPENAI_BASE_URL=...         OPENAI_API_KEY=...
# GOOGLE_GEMINI_BASE_URL=...  GEMINI_API_KEY=...
# DEEPSEEK_BASE_URL=...       DEEPSEEK_API_KEY=...
