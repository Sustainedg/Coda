{
  "name": "coda-desktop",
  "productName": "Coda",
  "private": true,
  "version": "0.1.8",
  "description": "Coda 桌面版 —— 把 AI 编程内核变成你的聊天同事（Windows / macOS）",
  "main": "dist-main/index.js",
  "author": "Coda",
  "license": "MIT",
  "scripts": {
    "build": "npm run check:runtimes && npm run compile && electron-builder --publish never",
    "compile": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "compile:main": "tsc -p tsconfig.main.json",
    "dev": "node scripts/dev.mjs",
    "dist:dir": "npm run check:runtimes && npm run compile && electron-builder --dir",
    "check:runtimes": "node scripts/check-runtimes.mjs",
    "fetch:node": "node scripts/fetch-node.mjs",
    "fetch:python": "node scripts/fetch-python.mjs",
    "prepare:deps": "node scripts/prepare-python-deps.mjs",
    "gen:icons": "python3 scripts/gen-icons.py",
    "gen:installer": "python3 scripts/gen-installer-assets.py",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@types/node": "22.10.5",
    "electron": "33.3.2",
    "electron-builder": "25.1.8",
    "typescript": "5.7.2"
  }
}
